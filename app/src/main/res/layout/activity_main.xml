<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.camera.view.PreviewView
        android:id="@+id/cameraPicture"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        app:implementationMode="compatible"
        app:scaleType="fillCenter" />

    <app.wireframe.kids.SkeletonView
        android:id="@+id/skeletons"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="24dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/loading"
            android:textColor="#CCFFFFFF"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/recordingBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/recording_badge"
            android:paddingHorizontal="14dp"
            android:paddingVertical="4dp"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/playGame"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="12dp"
        android:layout_marginTop="60dp"
        android:background="@drawable/recording_badge"
        android:backgroundTint="#CC7C4DFF"
        android:contentDescription="Play the Copy me pose game"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:text="🎯 Copy me!"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/toggleSound"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="100dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/recording_badge"
        android:backgroundTint="#55FFFFFF"
        android:contentDescription="Turn sounds on or off"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:text="🔊 Sound"
        android:textColor="@android:color/white"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/switchModel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="60dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/recording_badge"
        android:backgroundTint="#55FFFFFF"
        android:contentDescription="Switch between the fast and the detailed model"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:textColor="@android:color/white"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="28dp"
        android:orientation="vertical">

        <HorizontalScrollView
            android:id="@+id/facePicker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:clipToPadding="false"
            android:paddingHorizontal="12dp"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/faceOptions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/showCamera"
                style="@style/BigButton"
                android:contentDescription="Show or hide the camera picture"
                android:text="👀" />

            <TextView
                android:id="@+id/pickFace"
                style="@style/BigButton"
                android:contentDescription="Choose a face"
                android:text="🙂" />

            <View
                android:id="@+id/record"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginHorizontal="8dp"
                android:background="@drawable/record_button"
                android:clickable="true"
                android:contentDescription="Record a video"
                android:focusable="true" />

            <TextView
                android:id="@+id/changeLook"
                style="@style/BigButton"
                android:contentDescription="Change colors"
                android:text="🎨" />

            <TextView
                android:id="@+id/flipCamera"
                style="@style/BigButton"
                android:contentDescription="Switch between front and back camera"
                android:text="🔄" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
