<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.camera.view.PreviewView
        android:id="@+id/cameraPicture"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        app:implementationMode="compatible"
        app:scaleType="fillCenter" />

    <app.stickme.kids.SkeletonView
        android:id="@+id/skeletons"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Only shown when there is something to say: loading, or nobody in the picture. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="76dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/loading"
            android:textColor="#CCFFFFFF"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/recordingBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/recording_badge"
            android:paddingHorizontal="14dp"
            android:paddingVertical="4dp"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="12dp"
        android:gravity="end"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/flipCamera"
                style="@style/SmallButton"
                android:contentDescription="Switch between front and back camera"
                android:text="🔄" />

            <TextView
                android:id="@+id/openSettings"
                style="@style/SmallButton"
                android:contentDescription="Settings for grown-ups"
                android:text="⚙️" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/settingsPanel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/recording_badge"
            android:backgroundTint="#E6222222"
            android:orientation="vertical"
            android:padding="6dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/switchModel"
                style="@style/SettingsRow"
                android:contentDescription="Switch between the fast and the detailed model" />

            <TextView
                android:id="@+id/toggleSound"
                style="@style/SettingsRow"
                android:contentDescription="Turn sounds on or off" />

            <TextView
                android:id="@+id/speedInfo"
                style="@style/SettingsRow"
                android:clickable="false"
                android:textColor="#99FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="28dp"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/gameMenu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/recording_badge"
            android:backgroundTint="#E6222222"
            android:padding="8dp"
            android:visibility="gone">

            <GridLayout
                android:id="@+id/gameOptions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:columnCount="4" />
        </FrameLayout>

        <HorizontalScrollView
            android:id="@+id/facePicker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:clipToPadding="false"
            android:paddingHorizontal="12dp"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/faceOptions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/showCamera"
                style="@style/BigButton"
                android:contentDescription="Show or hide the camera picture"
                android:text="👀" />

            <TextView
                android:id="@+id/pickFace"
                style="@style/BigButton"
                android:contentDescription="Choose a face"
                android:text="🙂" />

            <View
                android:id="@+id/record"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginHorizontal="8dp"
                android:background="@drawable/record_button"
                android:clickable="true"
                android:contentDescription="Record a video"
                android:focusable="true" />

            <TextView
                android:id="@+id/changeLook"
                style="@style/BigButton"
                android:contentDescription="Change colors"
                android:text="🎨" />

            <TextView
                android:id="@+id/playGame"
                style="@style/BigButton"
                android:contentDescription="Choose a game"
                android:text="🎯" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
