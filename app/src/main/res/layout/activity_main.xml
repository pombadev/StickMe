<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.camera.view.PreviewView
        android:id="@+id/cameraPicture"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        app:implementationMode="compatible"
        app:scaleType="fillCenter" />

    <app.stickme.kids.SkeletonView
        android:id="@+id/skeletons"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <include layout="@layout/play_chrome" />

    <!-- Top corner: switch camera, and the lock that opens settings (hold it). -->
    <LinearLayout
        android:id="@+id/cornerButtons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="34dp"
        android:orientation="horizontal">

        <app.stickme.kids.StickerButton
            android:id="@+id/flipCamera"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:contentDescription="Switch camera"
            android:rotation="-6"
            app:stickerColor="@color/blue"
            app:stickerShape="circle">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_flip_camera" />
        </app.stickme.kids.StickerButton>

        <app.stickme.kids.StickerButton
            android:id="@+id/openSettings"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="12dp"
            android:contentDescription="Grown-up settings, press and hold"
            android:rotation="5"
            app:stickerColor="@color/chalk"
            app:stickerShape="circle">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_lock" />
        </app.stickme.kids.StickerButton>
    </LinearLayout>

    <!-- The dock: five stickers on a strip of torn cardboard. -->
    <FrameLayout
        android:id="@+id/dock"
        android:layout_width="match_parent"
        android:layout_height="170dp"
        android:layout_gravity="bottom"
        android:clipChildren="false">

        <app.stickme.kids.TornStripView
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginBottom="34dp"
            android:clipChildren="false"
            android:gravity="bottom"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <LinearLayout style="@style/DockCell">

                <app.stickme.kids.StickerButton
                    android:id="@+id/showCamera"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:contentDescription="Show camera picture"
                    android:rotation="-5"
                    app:stickerColor="@color/chalk"
                    app:stickerRadius="16dp"
                    app:stickerShape="rounded">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_eye" />
                </app.stickme.kids.StickerButton>

                <TextView
                    style="@style/DockLabel"
                    android:text="camera" />
            </LinearLayout>

            <LinearLayout style="@style/DockCell">

                <app.stickme.kids.StickerButton
                    android:id="@+id/pickFace"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:contentDescription="Choose a face"
                    android:rotation="4"
                    app:stickerColor="@color/pink"
                    app:stickerShape="circle">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_face" />
                </app.stickme.kids.StickerButton>

                <TextView
                    style="@style/DockLabel"
                    android:text="face" />
            </LinearLayout>

            <LinearLayout style="@style/DockCell">

                <app.stickme.kids.StickerButton
                    android:id="@+id/record"
                    android:layout_width="82dp"
                    android:layout_height="82dp"
                    android:layout_marginTop="-26dp"
                    android:contentDescription="Record a video"
                    android:rotation="-3"
                    app:stickerColor="@color/red"
                    app:stickerShape="circle">

                    <View
                        android:id="@+id/recordDot"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center" />
                </app.stickme.kids.StickerButton>

                <TextView
                    android:id="@+id/recordLabel"
                    style="@style/DockLabel"
                    android:text="record" />
            </LinearLayout>

            <LinearLayout style="@style/DockCell">

                <app.stickme.kids.StickerButton
                    android:id="@+id/changeLook"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:contentDescription="Change look"
                    android:rotation="6"
                    app:stickerColor="@color/mint"
                    app:stickerRadius="16dp"
                    app:stickerShape="rounded">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_look" />
                </app.stickme.kids.StickerButton>

                <TextView
                    style="@style/DockLabel"
                    android:text="look" />
            </LinearLayout>

            <LinearLayout style="@style/DockCell">

                <app.stickme.kids.StickerButton
                    android:id="@+id/playGame"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:contentDescription="Play a game"
                    android:rotation="-4"
                    app:stickerColor="@color/yellow"
                    app:stickerRadius="16dp"
                    app:stickerShape="rounded">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_star" />
                </app.stickme.kids.StickerButton>

                <TextView
                    style="@style/DockLabel"
                    android:text="games" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <include layout="@layout/game_controls" />

    <include layout="@layout/overlays" />
</FrameLayout>
