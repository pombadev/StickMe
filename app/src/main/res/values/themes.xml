<resources>
    <style name="Theme.StickMe" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/chalkboard</item>
        <item name="android:statusBarColor">@color/chalkboard</item>
        <item name="android:navigationBarColor">@color/chalkboard</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <!-- Handwriting, for body text. -->
    <style name="Chalk">
        <item name="android:fontFamily">@font/gochi_hand</item>
        <item name="android:textColor">@color/chalk</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- Fat rounded letters, for titles and big buttons. -->
    <style name="Heading" parent="Chalk">
        <item name="android:fontFamily">@font/bagel_fat_one</item>
    </style>

    <!-- Small print for grown-ups, in a plain system font so it stays easy to read. -->
    <style name="Fine">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/ink_brown</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <!-- The small caption under a dock sticker. -->
    <style name="DockLabel" parent="Chalk">
        <item name="android:textColor">@color/ink_warm</item>
        <item name="android:textSize">19sp</item>
    </style>

    <!-- A row in the grown-ups folder: a tick box and a word. -->
    <style name="Option">
        <item name="android:minHeight">48dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="OptionText" parent="Chalk">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">24sp</item>
    </style>

</resources>
